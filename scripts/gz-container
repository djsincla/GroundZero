#!/usr/bin/env bash
# Run GroundZero as a single container. Uses Podman by default (free, no Docker Desktop licence);
# set GZ_ENGINE=docker to use the docker CLI with Colima/Rancher Desktop instead.
#
#   scripts/gz-container build                 build the image
#   scripts/gz-container up [--bmc 198.51.100.11]  start (media URL auto-detected from the route to the BMC)
#   scripts/gz-container ui | token | logs | status | shell | down
#
# Extra engine flags (e.g. -e VAR=x) can be passed in GZ_EXTRA_ARGS.
# State persists in the "groundzero-data" volume (GZ_VOLUME); ISOs are read from ./images (read-only).
set -euo pipefail

ENGINE="${GZ_ENGINE:-podman}"
IMAGE="${GZ_IMAGE:-localhost/groundzero:latest}"
NAME="${GZ_NAME:-groundzero}"
VOLUME="${GZ_VOLUME:-groundzero-data}"
API_PORT="${GZ_API_PORT:-7182}"
MEDIA_PORT="${GZ_MEDIA_PORT:-443}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ISOS="${GROUNDZERO_ISO_REPOSITORY:-$ROOT/images}"

die() { echo "gz-container: $*" >&2; exit 1; }
command -v "$ENGINE" >/dev/null || die "$ENGINE not found (macOS: brew install podman && podman machine init && podman machine start)"

# The BMC fetches install media from *this machine*, not from the container, so the media URL must use
# the host's own address on the route to the BMC (e.g. the GlobalProtect VPN address).
host_ip_towards() {
  local target="$1" iface
  if [[ "$(uname)" == "Darwin" ]]; then
    iface="$(route -n get "$target" 2>/dev/null | awk '/interface:/ {print $2}')"
    [[ -n "$iface" ]] && ifconfig "$iface" | awk '/inet / {print $2; exit}'  # works for VPN utun too
  else
    ip route get "$target" 2>/dev/null | awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}'
  fi
}

bmc_default() {
  [[ -f "$ROOT/.env" ]] && sed -n 's/^GROUNDZERO_LIVE_BMC=//p' "$ROOT/.env" | head -1
}

cmd="${1:-}"; shift || true
case "$cmd" in
  build)
    fmt=(); [[ "$ENGINE" == "podman" ]] && fmt=(--format docker)  # keeps the HEALTHCHECK
    "$ENGINE" build "${fmt[@]}" -t "$IMAGE" -f "$ROOT/Containerfile" "$ROOT"
    ;;
  up)
    bmc="$(bmc_default || true)"
    [[ "${1:-}" == "--bmc" ]] && bmc="${2:?--bmc needs an address}"
    url="${GROUNDZERO_MEDIA_PUBLIC_URL:-}"
    if [[ -z "$url" ]]; then
      [[ -n "$bmc" ]] || die "pass --bmc ADDRESS (or set GROUNDZERO_MEDIA_PUBLIC_URL) so the media URL can be detected"
      ip="$(host_ip_towards "$bmc" || true)"
      [[ -n "$ip" ]] || die "no route to $bmc: connect the VPN first, or set GROUNDZERO_MEDIA_PUBLIC_URL"
      url="https://$ip"
      [[ "$MEDIA_PORT" == "443" ]] || url="$url:$MEDIA_PORT"
    fi
    mkdir -p "$ISOS"
    "$ENGINE" rm -f "$NAME" >/dev/null 2>&1 || true
    "$ENGINE" run -d --name "$NAME" --restart unless-stopped \
      -p "127.0.0.1:$API_PORT:7182" -p "$MEDIA_PORT:8443" \
      -v "$VOLUME:/data" -v "$ISOS:/isos:ro" \
      -e GROUNDZERO_MEDIA_PUBLIC_URL="$url" \
      ${GZ_EXTRA_ARGS:-} \
      "$IMAGE" >/dev/null
    echo "GroundZero is up: API/UI http://127.0.0.1:$API_PORT, media $url (ISOs from $ISOS)"
    echo "If the VPN address changes, run '$0 up' again."
    ;;
  token)  "$ENGINE" exec "$NAME" groundzero token show ;;
  ui)     open_cmd="$(command -v open || command -v xdg-open)"
          "$open_cmd" "http://127.0.0.1:$API_PORT/#token=$("$ENGINE" exec "$NAME" groundzero token show)" ;;
  logs)   "$ENGINE" logs -f "$NAME" ;;
  status) "$ENGINE" ps --filter "name=^$NAME\$" ;;
  shell)  "$ENGINE" exec -it "$NAME" bash ;;
  down)   "$ENGINE" rm -f "$NAME" ;;
  *)      sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
