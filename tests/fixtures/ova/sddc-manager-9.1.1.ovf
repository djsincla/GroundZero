      <Property ovf:key="ROOT_PASSWORD" ovf:type="string" ovf:qualifiers="MinLen(15),MaxLen(65535)" ovf:userConfigurable="true" ovf:password="true">
        <Label>Enter root user Password</Label>
        <Description>This will be used as an initial password for the root user account. The password needs to be at least 15 characters, contain at least 1 digit, 1 uppercase, 1 lowercase, 1 non-alphanumeric character and should pass the dictionary check (not too simplistic/systematic)</Description>
      </Property>
      <Property ovf:key="LOCAL_USER_PASSWORD" ovf:type="string" ovf:qualifiers="MinLen(15),MaxLen(65535)" ovf:userConfigurable="true" ovf:password="true">
        <Label>Enter local user password</Label>
        <Description>This will be used as an initial password for the admin@local and vcf (SSH) users. The password needs to be at least 15 characters, contain at least 1 digit, 1 uppercase, 1 lowercase, 1 non-alphanumeric character (any of !%@$^#?*) and should pass the dictionary check (not too simplistic/systematic).</Description>
      </Property>
      <Property ovf:key="VCF_PASSWORD" ovf:type="string" ovf:password="true">
        <Label>Enter vcf user password</Label>
        <Description>This will be used as an initial login password for the vcf user account. vcf is only user allowed to login to VM</Description>
      </Property>
      <Property ovf:key="BASIC_AUTH_PASSWORD" ovf:type="string" ovf:password="true">
        <Label>Enter Basic Auth user password</Label>
        <Description>This will be used as an initial password for the Basic Auth user account.</Description>
      </Property>
      <Property ovf:key="BACKUP_PASSWORD" ovf:type="string" ovf:password="true">
        <Label>Enter backup user password</Label>
        <Description>This will be used as an initial password for the backup user account.</Description>
      </Property>
      <Property ovf:key="vami.hostname" ovf:type="string" ovf:userConfigurable="true">
        <Label>Host Name</Label>
